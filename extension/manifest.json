{
  "manifest_version": 3,
  "name": "StaffForge Autofill",
  "version": "1.0.0",
  "description": "Autofill Minecraft staff applications for review only.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:5000/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  }
}